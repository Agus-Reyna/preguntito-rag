# === BASE DE DATOS ===
DATABASE_URL=postgresql+psycopg2://rag:rag@db:5432/rag

# === OLLAMA ===
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# === IMAGEN DE OLLAMA ===
# CPU (por defecto) → ollama/ollama
# GPU AMD          → ollama/ollama:rocm
# GPU NVIDIA       → ollama/ollama
OLLAMA_IMAGE=ollama/ollama

# === GPU AMD (opcional, experimental) ===
# Dejá vacío si usás CPU o NVIDIA
# Ejemplos: RX 5500 XT / RX 6700 XT → 10.3.0 | RX 7900 XTX → 11.0.0
HSA_OVERRIDE_GFX_VERSION=